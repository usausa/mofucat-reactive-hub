<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mofucat.ReactiveHub</PackageId>
    <Title>Mofucat.ReactiveHub</Title>
    <Description>Reactive SignalR hub connection</Description>
    <PackageTags>signalr rx reactive hubconnection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

</Project>
